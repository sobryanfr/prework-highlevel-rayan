<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="talebot27">
  <material name="team_blue"><color rgba="0.0 0.35 0.75 1.0"/></material>
  <material name="emergency_red"><color rgba="0.9 0.0 0.0 1.0"/></material>
  <material name="mast_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.17" length="0.30"/></geometry>
      <material name="team_blue"/>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="beacon_support">
    <visual>
      <geometry><box size="0.08 0.08 0.13"/></geometry>
      <material name="mast_grey"/>
    </visual>
  </link>
  <joint name="beacon_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="beacon_support"/>
    <origin xyz="0 0 0.215" rpy="0 0 0"/>
  </joint>

  <link name="emergency_button">
    <visual>
      <geometry><cylinder radius="0.015" length="0.025"/></geometry>
      <material name="emergency_red"/>
    </visual>
  </link>
  <joint name="emergency_button_joint" type="fixed">
    <parent link="base_link"/>
    <child link="emergency_button"/>
    <origin xyz="0.10 0 0.16" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
  </joint>

  <link name="imu_frame"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_frame"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>
</robot>
